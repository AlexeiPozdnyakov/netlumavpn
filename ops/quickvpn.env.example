# NetlumaVPN server environment example.
# Copy to /etc/quickvpn/quickvpn.env on the VPS, fill secrets there only,
# then keep this repository version secret-free.

NETLUMAVPN_DB_PATH='/opt/quickvpn/data/quickvpn.sqlite3'
# Legacy alias accepted by the backend during migration:
# QUICKVPN_DB_PATH='/opt/quickvpn/data/quickvpn.sqlite3'
XRAY_CONFIG_PATH='/usr/local/etc/xray/config.json'
XRAY_BIN='/usr/local/bin/xray'
XRAY_API_SERVER='127.0.0.1:10085'
XRAY_SERVICE='xray'

# Public endpoints returned to clients.
VPN_HOST='vpn.netlumavpn.example'
VPN_PORT='443'
TROJAN_HOST='trojan.netlumavpn.example'

# Local listeners behind nginx stream SNI routing.
XRAY_LISTEN_HOST='127.0.0.1'
XRAY_LISTEN_PORT='1443'
TROJAN_LISTEN_HOST='127.0.0.1'
TROJAN_LISTEN_PORT='2443'
TROJAN_CERT_FILE='/etc/xray/certs/api.netlumavpn.example.fullchain.pem'
TROJAN_KEY_FILE='/etc/xray/certs/api.netlumavpn.example.privkey.pem'
TROJAN_FINGERPRINT='chrome'

# VLESS Reality. Generate with `xray x25519` and `openssl rand -hex 8`.
REALITY_PRIVATE_KEY='CHANGE_ME'
REALITY_PUBLIC_KEY='CHANGE_ME'
REALITY_SHORT_ID='CHANGE_ME'
REALITY_SERVER_NAME='www.microsoft.com'
REALITY_DEST='www.microsoft.com:443'
REALITY_FINGERPRINT='chrome'
REALITY_SPIDER_X='/'
VLESS_FLOW=''
VLESS_COMPATIBILITY_FLOW=''

# Admin and API credentials. Generate on the VPS, do not commit real values.
ADMIN_USER='admin'
ADMIN_PASSWORD_HASH='CHANGE_ME'
SESSION_SECRET='CHANGE_ME'
API_KEY='CHANGE_ME'
MOBILE_API_KEY='CHANGE_ME_MATCH_APP_CONSTANTS'
APP_STORE_URL='https://apps.apple.com/search?term=NetlumaVPN'

# WireGuard.
WG_BIN='/usr/bin/wg'
WIREGUARD_CONFIG_PATH='/etc/wireguard/wg0.conf'
WIREGUARD_SERVICE='wg-quick@wg0'
WIREGUARD_INTERFACE='wg0'
WIREGUARD_PORT='51820'
WIREGUARD_NETWORK='10.8.0.0/24'
WIREGUARD_SERVER_ADDRESS='10.8.0.1/24'
WIREGUARD_SERVER_PRIVATE_KEY='CHANGE_ME'
WIREGUARD_SERVER_PUBLIC_KEY='CHANGE_ME'
WIREGUARD_ALLOWED_IPS='0.0.0.0/0'
WIREGUARD_PERSISTENT_KEEPALIVE='25'
WIREGUARD_MTU='1280'
WIREGUARD_NAT_INTERFACE='eth0'

<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-view-controller">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="Named colors" minToolsVersion="9.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-view-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root-view">
                        <rect key="frame" x="0.0" y="0.0" width="600" height="600"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchBackgroundGradient" translatesAutoresizingMaskIntoConstraints="NO" id="launch-background-image">
                                <rect key="frame" x="0.0" y="0.0" width="600" height="600"/>
                            </imageView>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="28" translatesAutoresizingMaskIntoConstraints="NO" id="launch-main-stack">
                                <rect key="frame" x="194" y="155" width="213" height="267"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon-container">
                                        <rect key="frame" x="40" y="0.0" width="132" height="132"/>
                                        <subviews>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchIconCard" translatesAutoresizingMaskIntoConstraints="NO" id="launch-icon-card-image">
                                                <rect key="frame" x="0.0" y="0.0" width="132" height="132"/>
                                            </imageView>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="shield.lefthalf.filled" catalog="system" translatesAutoresizingMaskIntoConstraints="NO" id="launch-shield-image">
                                                <rect key="frame" x="35" y="35" width="62" height="62"/>
                                                <color key="tintColor" red="0.20392156862745098" green="0.82745098039215681" blue="0.59999999999999998" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </imageView>
                                        </subviews>
                                        <constraints>
                                            <constraint firstItem="launch-icon-card-image" firstAttribute="centerX" secondItem="launch-icon-container" secondAttribute="centerX" id="launch-icon-card-center-x"/>
                                            <constraint firstItem="launch-icon-card-image" firstAttribute="centerY" secondItem="launch-icon-container" secondAttribute="centerY" id="launch-icon-card-center-y"/>
                                            <constraint firstItem="launch-icon-card-image" firstAttribute="height" constant="132" id="launch-icon-card-height"/>
                                            <constraint firstItem="launch-icon-card-image" firstAttribute="width" constant="132" id="launch-icon-card-width"/>
                                            <constraint firstAttribute="height" constant="132" id="launch-icon-height"/>
                                            <constraint firstAttribute="width" constant="132" id="launch-icon-width"/>
                                            <constraint firstItem="launch-shield-image" firstAttribute="centerX" secondItem="launch-icon-container" secondAttribute="centerX" id="launch-shield-center-x"/>
                                            <constraint firstItem="launch-shield-image" firstAttribute="centerY" secondItem="launch-icon-container" secondAttribute="centerY" id="launch-shield-center-y"/>
                                            <constraint firstItem="launch-shield-image" firstAttribute="height" constant="62" id="launch-shield-height"/>
                                            <constraint firstItem="launch-shield-image" firstAttribute="width" constant="62" id="launch-shield-width"/>
                                        </constraints>
                                    </view>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="launch-title-stack">
                                        <rect key="frame" x="0.0" y="160" width="213" height="67"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="NetlumaVPN" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="launch-title-label">
                                                <rect key="frame" x="0.0" y="0.0" width="213" height="43"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="36"/>
                                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Secure tunnel" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="launch-subtitle-label">
                                                <rect key="frame" x="61" y="51" width="90" height="16"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="13"/>
                                                <color key="textColor" red="0.58039215686274515" green="0.63921568627450975" blue="0.72156862745098038" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <nil key="highlightedColor"/>
                                            </label>
                                        </subviews>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="center" spacing="4" translatesAutoresizingMaskIntoConstraints="NO" id="launch-loader-padded-stack">
                                        <rect key="frame" x="86" y="255" width="40" height="12"/>
                                        <subviews>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="launch-loader-spacer">
                                                <rect key="frame" x="20" y="0.0" width="0.0" height="0.0"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" id="launch-loader-spacer-height"/>
                                                </constraints>
                                            </view>
                                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchLoader" translatesAutoresizingMaskIntoConstraints="NO" id="launch-loader-image">
                                                <rect key="frame" x="0.0" y="4" width="40" height="8"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="8" id="launch-loader-height"/>
                                                    <constraint firstAttribute="width" constant="40" id="launch-loader-width"/>
                                                </constraints>
                                            </imageView>
                                        </subviews>
                                    </stackView>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="SE2-cg-Ejl"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <constraint firstAttribute="bottom" secondItem="launch-background-image" secondAttribute="bottom" id="launch-background-bottom"/>
                            <constraint firstItem="launch-background-image" firstAttribute="leading" secondItem="launch-root-view" secondAttribute="leading" id="launch-background-leading"/>
                            <constraint firstItem="launch-background-image" firstAttribute="top" secondItem="launch-root-view" secondAttribute="top" id="launch-background-top"/>
                            <constraint firstAttribute="trailing" secondItem="launch-background-image" secondAttribute="trailing" id="launch-background-trailing"/>
                            <constraint firstItem="launch-main-stack" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" id="launch-main-center-x"/>
                            <constraint firstItem="launch-main-stack" firstAttribute="centerY" secondItem="launch-root-view" secondAttribute="centerY" constant="-12" id="launch-main-center-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="launch-first-responder" sceneMemberID="firstResponder"/>
